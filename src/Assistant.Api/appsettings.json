{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Channels": {
    "PublicBaseUrl": "",
    "MaxApprovedPeersPerChannel": 1,
    "MaxPendingPeers": 3,
    "MaxPairingAttempts": 5,
    "PairingCodeTtl": "01:00:00",
    "DeepLinkTokenTtl": "00:10:00",
    "PairingReminderInterval": "00:10:00",
    "InboxParallelism": 4,
    "InboxRetention": {
      "telegram": "3.00:00:00",
      "whatsapp": "8.00:00:00"
    },
    "Remote": {
      "WebOnlyTools": [],
      "AllowSensitiveActions": true
    }
  },
  "WebPush": {
    "Enabled": false,
    "VapidSubject": "",
    "VapidPublicKey": "",
    "VapidPrivateKey": "",
    "AllowedEndpointHosts": [
      "fcm.googleapis.com",
      "*.push.apple.com",
      "updates.push.services.mozilla.com",
      "*.notify.windows.com"
    ]
  },
  "Delivery": {
    "Order": ["hub", "webpush", "telegram", "whatsapp"],
    "Mode": "FirstSuccess",
    "HubAckTimeout": "00:00:05",
    "MaxNotificationsPerHour": 30,
    "QuietHours": {
      "Enabled": true,
      "Start": "23:30",
      "End": "08:00"
    }
  },
  "Scheduler": {
    "Enabled": true,
    "PulseInterval": "00:00:05",
    "BatchSize": 10,
    "MaxDegreeOfParallelism": 4,
    "Lease": "00:02:00"
  },
  "Telegram": {
    "Enabled": false,
    "Mode": "Webhook",
    "BotToken": "",
    "BotUsername": "",
    "WebhookSecret": "",
    "ManageWebhook": true,
    "MaxConnections": 5,
    "MaxVoiceSeconds": 120,
    "VoiceReplies": "Never",
    "UseRichMessages": true,
    "UseDraftStreaming": true,
    "DraftUpdateInterval": "00:00:01"
  },
  "Reminders": {
    "Enabled": true,
    "MinLeadTime": "00:00:30",
    "MaxHorizonDays": 730,
    "MaxActive": 50,
    "MaxSnoozesPerOccurrence": 6,
    "LateGrace": "00:02:00",
    "MissedAfter": "12:00:00"
  },
  "Proactive": {
    "Suggestions": {
      "QuietStart": "22:00",
      "QuietEnd": "08:00",
      "MaxPerDay": 3,
      "HeartbeatEvery": 30
    }
  }
