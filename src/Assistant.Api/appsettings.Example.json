{
  "ConnectionStrings": {
    "Assistant": "Host=localhost;Port=5432;Database=assistant;Username=assistant;Password=<user-secrets>"
  },
  "Auth": {
    "Mode": "Bearer",
    "BearerToken": "<user-secrets>"
  },
  "Assistant": {
    "Api": {
      "AllowedOrigins": [ "http://localhost:5173", "https://localhost:5173" ],
      "VerifySchemaOnStart": true
    },
    "Personality": { "ProfilePath": "config/personality.yaml" },
    "Context": { "TokenBudget": 8000, "HistoryMaxMessages": 40 },
    "Models": {
      "Conversation": {
        "Provider": "openrouter",
        "Endpoint": "https://openrouter.ai/api/v1",
        "Model": "meta-llama/llama-3.1-8b-instruct",
        "ApiKey": "<user-secrets>",
        "Temperature": 0.7,
        "MaxOutputTokens": 4096,
        "OpenRouter": {
          "Zdr": true,
          "DataCollection": "deny"
        }
      },
      "Utility": {
        "Provider": "openrouter",
        "Endpoint": "https://openrouter.ai/api/v1",
        "Model": "openai/gpt-4o-mini",
        "ApiKey": "<user-secrets>",
        "Temperature": 0.2,
        "MaxOutputTokens": 2048,
        "OpenRouter": {
          "Sort": "price",
          "Zdr": true,
          "DataCollection": "deny"
        }
      },
      "Embedding": {
        "Provider": "Local",
        "Model": "microsoft/harrier-oss-v1-270m",
        "Dimensions": 640,
        "QueryPrefix": "Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery: ",
        "DocumentPrefix": "",
        "ModelPath": "models/harrier-oss-v1-270m"
      }
    },
    "Speech": {
      "Stt": {
        // Development default stays Deepgram. Scribe v2 won the V2-04.1 WER table
        // (Provider openrouter, Model elevenlabs/scribe-v2, Endpoint https://openrouter.ai/api/v1,
        // PricePerMinuteUsd 0.00366) but is not selected: the transcript arrived in about 1.5 s.
        "Provider": "deepgram",
        "Language": "es",
        "Model": "nova-3",
        "Keyterms": [ "Vera" ],
        "Endpoint": "https://api.deepgram.com",
        "ApiKey": "<user-secrets>",
        "PricePerMinuteUsd": 0
      },
      "Tts": {
        "Provider": "elevenlabs",
        "VoiceId": "<elevenlabs-voice-id>",
        "Speed": 1.0,
        "Model": "eleven_flash_v2_5",
        "OptimizeStreamingLatency": 4,
        "Endpoint": "https://api.elevenlabs.io",
        "ApiKey": "<user-secrets>",
        "PricePerMillionCharactersUsd": 0
      },
      "Segmenter": {
        "FirstMinChars": 1,
        "SubsequentMinChars": 48,
        "FirstMaxChars": 80,
        "SubsequentMaxChars": 220
      }
    },
    "Permissions": { "AutoAllowReversible": true, "ConfirmationTimeoutSeconds": 300 },
    "Tools": { "TimeoutSeconds": 30 },
    "Turn": { "MaxToolIterations": 5 },
    "Costs": {
      "MonthlyBudgetUsd": 0,
      "WarnAtPercent": 80,
      "Prices": {
        "qwen/qwen-2.5-7b-instruct": { "InputPerMillionUsd": 0.10, "CachedInputPerMillionUsd": 0.10, "CacheWritePerMillionUsd": 0, "OutputPerMillionUsd": 0.20 },
        "meta-llama/llama-3.1-8b-instruct": { "InputPerMillionUsd": 0.05, "CachedInputPerMillionUsd": 0.05, "CacheWritePerMillionUsd": 0, "OutputPerMillionUsd": 0.08 },
        "meta-llama/llama-3.3-70b-instruct": { "InputPerMillionUsd": 0.59, "CachedInputPerMillionUsd": 0.59, "CacheWritePerMillionUsd": 0, "OutputPerMillionUsd": 0.79 },
        "meta-llama/llama-4-maverick": { "InputPerMillionUsd": 0.19, "CachedInputPerMillionUsd": 0.19, "CacheWritePerMillionUsd": 0, "OutputPerMillionUsd": 0.65 },
        "openai/gpt-oss-20b": { "InputPerMillionUsd": 0.03, "CachedInputPerMillionUsd": 0.03, "CacheWritePerMillionUsd": 0, "OutputPerMillionUsd": 0.13 },
        "openai/gpt-4o-mini": { "InputPerMillionUsd": 0.15, "CachedInputPerMillionUsd": 0.075, "CacheWritePerMillionUsd": 0, "OutputPerMillionUsd": 0.60 },
        "google/gemini-2.5-flash-lite": { "InputPerMillionUsd": 0.10, "CachedInputPerMillionUsd": 0.10, "CacheWritePerMillionUsd": 0, "OutputPerMillionUsd": 0.40 },
        "openai/text-embedding-3-small": { "InputPerMillionUsd": 0.02, "CachedInputPerMillionUsd": 0.02, "CacheWritePerMillionUsd": 0, "OutputPerMillionUsd": 0 },
        "microsoft/harrier-oss-v1-270m": { "InputPerMillionUsd": 0, "CachedInputPerMillionUsd": 0, "CacheWritePerMillionUsd": 0, "OutputPerMillionUsd": 0 }
      }
    }
  },
  "WebPush": {
    "Enabled": false,
    "AllowedEndpointHosts": [
      "fcm.googleapis.com",
      "*.push.apple.com",
      "updates.push.services.mozilla.com",
      "*.notify.windows.com"
    ]
  },
  "OpenTelemetry": { "OtlpEndpoint": "http://localhost:18889" }
}
