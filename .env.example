POSTGRES_DB=assistant
POSTGRES_USER=assistant
POSTGRES_PASSWORD=cambiar-en-el-env-local
# Login de la API. No es el superusuario del contenedor: lo crea docker/db/init/02-runtime-role.sh.
POSTGRES_APP_USER=assistant_app
POSTGRES_APP_PASSWORD=cambiar-en-el-env-local

# Secretos locales (no commitear valores reales)
# AUTH_BEARER_TOKEN: inventalo vos (mín. 32 chars). NO es la key de OpenRouter.
# Se usa en la API y se embebe en la SPA al hacer `docker compose build`.
AUTH_BEARER_TOKEN=cambiar-por-un-token-de-al-menos-32-chars
# Key de OpenRouter (o el proveedor configurado en Models)
LLM_API_KEY=
# Modelo de conversación (F2). Default: meta-llama/llama-3.1-8b-instruct (mejor F4 medido en PT-20).
# Cue de gesto (2b): google/gemini-2.5-flash-lite sigue [[cue:]] sin el salto de latencia de los :free.
# LLM_CONVERSATION_MODEL=google/gemini-2.5-flash-lite
# Modelo Utility (tools/costo). Default: openai/gpt-4o-mini.
# LLM_UTILITY_MODEL=openai/gpt-4o-mini
# Modelo de embeddings (PT-36). Default: openai/text-embedding-3-small (dimensión 1536).
# LLM_EMBEDDING_MODEL=openai/text-embedding-3-small

# Voz (PT-14). No commitear valores reales.
# Deepgram: https://console.deepgram.com
STT_API_KEY=
# ElevenLabs: https://elevenlabs.io/app/settings/api-keys
TTS_API_KEY=
# Voice ID de la biblioteca de ElevenLabs (no la API key).
# https://elevenlabs.io/app/voice-library — una voz en español.
TTS_VOICE_ID=
# Flash suele pedir plan pago. En el free: eleven_multilingual_v2 o eleven_turbo_v2_5
TTS_MODEL=eleven_flash_v2_5

# Servidor MCP de Coolify (servicio coolify-mcp). El asistente no ve estas variables.
# Origin del panel, sin /api/v1. El UUID de producción no entra al git.
COOLIFY_API_URL=
COOLIFY_API_TOKEN=
COOLIFY_ALLOWLIST=

# Docling (V2-06.5). La clave no se commitea. El servicio la exige y la API la manda como X-Api-Key.
# Topes en compose: 60 páginas y 15 MB.
DOCLING_SERVE_API_KEY=

# Telegram (PT-80). El compose local usa polling; dejalo apagado hasta tener un bot de prueba.
# TELEGRAM_MODE=Polling no exige secreto. Si lo habilitás, Channels:PublicBaseUrl tiene que ser https.
TELEGRAM_ENABLED=false
TELEGRAM_MODE=Polling
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
ASSISTANT_PUBLIC_BASE_URL=
